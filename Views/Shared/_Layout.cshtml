<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ege Havale Proje Ödevi</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EgeHavaleProjeOdevi.styles.css" asp-append-version="true" />
</head>
<body style="background-color: #f7f9fa;">
    <header>
        <nav class="navbar navbar-expand-lg border-bottom shadow-sm mb-4 py-3 sticky-top" style="background-color: #ffcc00;">
            <div class="container d-flex align-items-center justify-content-between">
                <!-- Logo Kısmı -->
                <a class="navbar-brand fw-bold fs-3 text-dark d-flex align-items-center me-4" asp-area="" asp-controller="Home" asp-action="Index" style="text-decoration:none;">
                    <i class="bi bi-house-door-fill me-2 fs-2"></i> EvBulalım.com
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".ustMenuAyar" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menüyü Aç">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse ustMenuAyar d-lg-flex justify-content-between">
                    <ul class="navbar-nav mb-2 mb-lg-0 d-flex gap-3">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold fs-5" asp-area="" asp-controller="Home" asp-action="Evler">Emlak</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold fs-5" asp-area="" asp-controller="Home" asp-action="Vasita">Vasıta</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold fs-5" asp-area="" asp-controller="Home" asp-action="IkinciEl">İkinci El</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold fs-5" asp-area="" asp-controller="Home" asp-action="IsIlanlari">İş İlanları</a>
                        </li>
                    </ul>

                    <form asp-controller="Home" asp-action="Arama" method="get" class="d-flex mx-lg-3 my-3 my-lg-0" style="flex: 1; max-width: 400px;" role="search">
                        <div class="input-group">
                            <input name="q" class="form-control shadow-none rounded-start-pill py-2" type="search" placeholder="Kelime ile arayın" aria-label="Arama">
                            <button class="btn btn-dark shadow-sm rounded-end-pill px-4" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>

                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Sepet" asp-action="Index" class="btn btn-light fw-bold rounded-pill shadow-sm px-4">
                            <i class="bi bi-star-fill text-warning"></i> Favorilerim
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="dropdown">
                                <button class="btn btn-dark fw-bold rounded-pill shadow-sm px-4 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle"></i> @User.Identity.Name
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item fw-bold text-danger" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Paneli</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-dark fw-bold rounded-pill shadow-sm px-4" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-person-fill"></i> Giriş Yap
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container" style="min-height: 65vh;">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-dark mt-auto" style="background-color: #f1f2f5;">
        <div class="container text-center py-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-award-fill text-warning me-2"></i>Ege Havale Proje Ödevi</h5>
            <p class="mb-0 text-secondary">&copy; @DateTime.Now.Year - Tüm Hakları Saklıdır.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
