@model EgeHavaleProjeOdevi.Models.Vasita

@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Vasıta İlanı Ekle" : "Vasıta İlanı Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="VasitaForm" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EklenmeTarihi" />
                        <input type="hidden" asp-for="Aktif" />
                        
                        <div class="mb-3">
                            <label asp-for="Ad" class="form-label">İlan Başlığı</label>
                            <input asp-for="Ad" class="form-control" required />
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Fiyat" class="form-label">Fiyat (TL)</label>
                                <input asp-for="Fiyat" class="form-control" type="number" step="0.01" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Kimden" class="form-label">Kimden</label>
                                <select asp-for="Kimden" class="form-select">
                                    <option value="Sahibinden">Sahibinden</option>
                                    <option value="Galeriden">Galeriden</option>
                                    <option value="Yetkili Bayi">Yetkili Bayi</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Adres" class="form-label">Adres / Konum</label>
                            <input asp-for="Adres" class="form-control" required />
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="ModelYili" class="form-label">Model Yılı</label>
                                <input asp-for="ModelYili" class="form-control" type="number" required />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Kilometre" class="form-label">Kilometre</label>
                                <input asp-for="Kilometre" class="form-control" type="number" required />
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Vites" class="form-label">Vites</label>
                                <select asp-for="Vites" class="form-select">
                                    <option value="Manuel">Manuel</option>
                                    <option value="Otomatik">Otomatik</option>
                                    <option value="Yarı Otomatik">Yarı Otomatik</option>
                                </select>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label asp-for="Yakit" class="form-label">Yakıt Türü</label>
                                <select asp-for="Yakit" class="form-select">
                                    <option value="Benzin">Benzin</option>
                                    <option value="Dizel">Dizel</option>
                                    <option value="LPG & Benzin">LPG & Benzin</option>
                                    <option value="Elektrik">Elektrik</option>
                                    <option value="Hibrit">Hibrit</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Görsel (Dosya Yükle VEYA URL Gir)</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-upload"></i> Dosya</span>
                                <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            </div>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-link"></i> URL</span>
                                <input asp-for="GorselUrl" class="form-control" placeholder="https://..." />
                            </div>
                            @if (!string.IsNullOrEmpty(Model.GorselUrl))
                            {
                                <div class="mt-2">Mevcut Görsel: <img src="@Model.GorselUrl" width="100" class="img-thumbnail" /></div>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Detaylar" class="form-label">İlan Detayı</label>
                            <textarea asp-for="Detaylar" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Vasitalar" class="btn btn-secondary">İptal</a>
                            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
