@model EgeHavaleProjeOdevi.Models.Esya

@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni İkinci El İlanı Ekle" : "İkinci El İlanı Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EsyaForm" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EklenmeTarihi" />
                        <input type="hidden" asp-for="Aktif" />
                        
                        <div class="mb-3">
                            <label asp-for="Ad" class="form-label">İlan Başlığı</label>
                            <input asp-for="Ad" class="form-control" required />
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Fiyat" class="form-label">Fiyat (TL)</label>
                                <input asp-for="Fiyat" class="form-control" type="number" step="0.01" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Kimden" class="form-label">Kimden</label>
                                <input asp-for="Kimden" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Adres" class="form-label">Adres / Konum</label>
                            <input asp-for="Adres" class="form-control" required />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Kategori" class="form-label">Kategori</label>
                                <input asp-for="Kategori" class="form-control" placeholder="Elektronik, Mobilya vb." required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Durum" class="form-label">Ürün Durumu</label>
                                <select asp-for="Durum" class="form-select">
                                    <option value="Sıfır">Sıfır</option>
                                    <option value="Yeni Gibi">Yeni Gibi</option>
                                    <option value="İkinci El">İkinci El</option>
                                    <option value="Hasarlı">Hasarlı</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Görsel (Dosya Yükle VEYA URL Gir)</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-upload"></i> Dosya</span>
                                <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            </div>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-link"></i> URL</span>
                                <input asp-for="GorselUrl" class="form-control" placeholder="https://..." />
                            </div>
                            @if (!string.IsNullOrEmpty(Model.GorselUrl))
                            {
                                <div class="mt-2">Mevcut Görsel: <img src="@Model.GorselUrl" width="100" class="img-thumbnail" /></div>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Detaylar" class="form-label">İlan Detayı</label>
                            <textarea asp-for="Detaylar" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Esyalar" class="btn btn-secondary">İptal</a>
                            <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
