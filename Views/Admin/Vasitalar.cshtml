@model IEnumerable<EgeHavaleProjeOdevi.Models.Vasita>

@{
    ViewData["Title"] = "Vasıta İlanları Yönetimi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Vasıta İlanları Yönetimi</h2>
        <div>
            <a asp-action="VasitaForm" class="btn btn-primary me-2"><i class="bi bi-plus-lg"></i> Yeni İlan Ekle</a>
            <a asp-action="Index" class="btn btn-secondary">Panele Dön</a>
        </div>
    </div>

    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Görsel</th>
                <th>Başlık</th>
                <th>Fiyat</th>
                <th>Model / KM</th>
                <th>Tarih</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>
                        <img src="@item.GorselUrl" alt="Görsel" style="width: 60px; height: 40px; object-fit: cover;" class="rounded" />
                    </td>
                    <td>@item.Ad</td>
                    <td>@item.Fiyat.ToString("C")</td>
                    <td>@item.ModelYili / @item.Kilometre</td>
                    <td>@item.EklenmeTarihi.ToShortDateString()</td>
                    <td>
                        <a asp-action="VasitaForm" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">
                            <i class="bi bi-pencil"></i> Düzenle
                        </a>
                        <a asp-action="VasitaSil" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bu ilanı silmek istediğinize emin misiniz?');">
                            <i class="bi bi-trash"></i> Sil
                        </a>
                    </td>
                </tr>
            }
            @if(!Model.Any()) {
                <tr><td colspan="7" class="text-center">Kayıtlı ilan bulunamadı.</td></tr>
            }
        </tbody>
    </table>
</div>
