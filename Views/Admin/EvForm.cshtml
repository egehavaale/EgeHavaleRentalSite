@model EgeHavaleProjeOdevi.Models.Ev

@{
    ViewData["Title"] = Model.Id == 0 ? "Yeni Emlak İlanı Ekle" : "Emlak İlanı Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@ViewData["Title"]</h4>
                </div>
                <div class="card-body">
                    <form asp-action="EvForm" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="EklenmeTarihi" />
                        <input type="hidden" asp-for="Aktif" />
                        
                        <div class="mb-3">
                            <label asp-for="Ad" class="form-label">İlan Başlığı</label>
                            <input asp-for="Ad" class="form-control" required />
                        </div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Fiyat" class="form-label">Fiyat (TL)</label>
                                <input asp-for="Fiyat" class="form-control" type="number" step="0.01" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Kimden" class="form-label">Kimden</label>
                                <select asp-for="Kimden" class="form-select">
                                    <option value="Sahibinden">Sahibinden</option>
                                    <option value="Emlak Ofisinden">Emlak Ofisinden</option>
                                    <option value="Müteahhitten">Müteahhitten</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Adres" class="form-label">Adres / Konum</label>
                            <input asp-for="Adres" class="form-control" required />
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="OdaSayisi" class="form-label">Oda Sayısı</label>
                                <input asp-for="OdaSayisi" class="form-control" placeholder="Örn: 3+1" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Metrekare" class="form-label">Metrekare (m²)</label>
                                <input asp-for="Metrekare" class="form-control" type="number" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Isitma" class="form-label">Isıtma</label>
                                <input asp-for="Isitma" class="form-control" required />
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="Esyali" class="form-check-input" />
                            <label class="form-check-label">Eşyalı mı?</label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Görsel (Dosya Yükle VEYA URL Gir)</label>
                            <div class="input-group mb-2">
                                <span class="input-group-text"><i class="bi bi-upload"></i> Dosya</span>
                                <input type="file" name="uploadImage" class="form-control" accept="image/*" />
                            </div>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-link"></i> URL</span>
                                <input asp-for="GorselUrl" class="form-control" placeholder="https://..." />
                            </div>
                            @if (!string.IsNullOrEmpty(Model.GorselUrl))
                            {
                                <div class="mt-2">Mevcut Görsel: <img src="@Model.GorselUrl" width="100" class="img-thumbnail" /></div>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Detaylar" class="form-label">İlan Detayı</label>
                            <textarea asp-for="Detaylar" class="form-control" rows="4"></textarea>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Evler" class="btn btn-secondary">İptal</a>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
