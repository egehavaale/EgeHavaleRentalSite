@model List<EgeHavaleProjeOdevi.Models.SepetItem>

@{
    ViewData["Title"] = "Favorilerim";
}

<div class="container mt-4 mb-5">
    <h3 class="fw-bold border-bottom pb-2 mb-4">
        <i class="bi bi-heart-fill text-danger"></i> Takip Ettiğim İlanlar
    </h3>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-cart-x fs-1"></i>
            <p class="mt-3">Henüz favori ilanınız bulunmuyor.</p>
            <a href="/" class="btn btn-primary">İlanları Keşfet</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                @foreach (var item in Model)
                {
                    <div class="card mb-3 shadow-sm border-0" style="border-radius: 12px; overflow:hidden;">
                        <div class="row g-0">
                            <div class="col-md-3">
                                <img src="@item.GorselUrl" class="img-fluid h-100" style="object-fit:cover; min-height: 120px;" alt="@item.IlanAdi">
                            </div>
                            <div class="col-md-9 py-2">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge bg-secondary mb-2">@item.IlanTipi</span>
                                        <h5 class="card-title fw-bold">@item.IlanAdi</h5>
                                        <p class="text-success fw-bold fs-5 mb-0">@item.Fiyat.ToString("C")</p>
                                    </div>
                                    <div class="text-end d-flex flex-column gap-2">
                                        @{
                                            string actionName = item.IlanTipi == "Vasita" ? "VasitaDetails" :
                                                                item.IlanTipi == "Esya" ? "EsyaDetails" : "Details";
                                        }
                                        <a href="@Url.Action(actionName, "Home", new { id = item.IlanId })" class="btn btn-warning fw-bold px-4">İlana Git</a>
                                        
                                        <form asp-action="Cikar" asp-controller="Sepet" method="post">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                                <i class="bi bi-trash"></i> Kaldır
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm" style="background-color: #f8f9fa; border-radius: 12px;">
                    <div class="card-body p-4">
                        <h5 class="card-title fw-bold border-bottom pb-3 mb-3">Hesap Özeti</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Toplam İlan</span>
                            <span class="fw-bold">@Model.Count Adet</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-0">
                            <span class="fs-5 fw-semibold">Toplam Tutar</span>
                            <span class="fs-4 fw-bold text-success">@Model.Sum(x => x.Fiyat).ToString("C")</span>
                        </div>
                        <button class="btn btn-primary w-100 mt-4 py-3 fw-bold rounded-pill">İşlemleri Onayla</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>