@model List<EgeHavaleProjeOdevi.Models.Ev>

@{
    ViewData["Title"] = "Emlak İlanları";
}

<div class="container mt-4 mb-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Ana Sayfa</a></li>
            <li class="breadcrumb-item active" aria-current="page">Emlak</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-house-door text-warning me-2"></i>Satılık & Kiralık Konutlar</h2>
            <p class="text-secondary mb-0">Bursa ve çevresindeki en güncel ilanlar</p>
        </div>
        <span class="badge bg-primary fs-6 py-2 px-3">Toplam @Model.Count İlan</span>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="p-3 bg-light rounded shadow-sm d-flex gap-2">
                <button class="btn btn-white border btn-sm shadow-sm">Fiyat Aralığı</button>
                <button class="btn btn-white border btn-sm shadow-sm">Oda Sayısı</button>
                <button class="btn btn-white border btn-sm shadow-sm">Metrekare</button>
            </div>
        </div>
    </div>

    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-search fs-1 text-muted"></i>
                <p class="mt-3 text-secondary">Aradığınız kriterlere uygun ev bulunamadı.</p>
            </div>
        }
        else
        {
            @foreach (var ev in Model)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0 listing-card" style="border-radius: 12px; overflow: hidden;">
                        <div class="position-relative">
                            <img src="@ev.GorselUrl" class="card-img-top" alt="@ev.Ad" style="height: 200px; object-fit: cover;" />
                            <div class="position-absolute bottom-0 start-0 m-2">
                                <span class="badge bg-dark opacity-75 fs-6">@ev.Fiyat.ToString("C")</span>
                            </div>
                        </div>

                        <div class="card-body p-3">
                            <h5 class="card-title text-primary fw-bold text-truncate" title="@ev.Ad">@ev.Ad</h5>
                            
                            <div class="d-flex justify-content-between mb-3 mt-2">
                                <small class="text-muted"><i class="bi bi-house-fill me-1"></i>@ev.OdaSayisi</small>
                                <small class="text-muted"><i class="bi bi-rulers me-1"></i>@ev.Metrekare m²</small>
                                <small class="text-muted"><i class="bi bi-geo-alt-fill me-1"></i>@ev.Adres.Split(',').Last()</small>
                            </div>

                            <p class="card-text text-secondary small" style="height: 40px; overflow: hidden;">
                                @ev.Detaylar
                            </p>
                        </div>

                        <div class="card-footer bg-white border-0 pb-3">
                            <a href="@Url.Action("Details", "Home", new { id = ev.Id })" class="btn btn-warning w-100 fw-bold shadow-sm" style="background-color: #ffcc00; border: none; border-radius: 8px;">
                                İlanı İncele
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <style>
        .listing-card {
            transition: all 0.3s ease-in-out;
        }

            .listing-card:hover {
                transform: translateY(-8px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.12) !important;
            }

        .bg-purple {
            background-color: #6f42c1;
        }
    </style>
}