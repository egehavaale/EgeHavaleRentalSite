@using Microsoft.AspNetCore.Identity
@model dynamic

@{
    ViewData["Title"] = "İlan Detayı";
}

<div class="container mt-4 mb-5">
    <div class="row">
        <div class="col-12 mb-3 border-bottom pb-2">
            <div class="d-flex justify-content-between align-items-end">
                <h3 class="fw-bold mb-0" style="color: #2c3e50;">@ViewBag.Ad</h3>
                <h2 class="text-success fw-bold mb-0">@ViewBag.Fiyat</h2>
            </div>
            <p class="text-muted mt-2 fw-semibold fs-5"><i class="bi bi-geo-alt"></i> @ViewBag.Adres</p>
        </div>
    </div>

    <div class="row bg-white shadow-sm p-4" style="border-radius: 8px;">
        <div class="col-md-7">
            <img src="@ViewBag.GorselUrl" class="img-fluid rounded border mb-4" style="width: 100%; object-fit: cover; max-height: 500px;" alt="@ViewBag.Ad" />
            
            <h4 class="fw-bold border-bottom pb-2">İlan Açıklaması</h4>
            <p class="lead" style="font-size: 1.1rem; line-height: 1.8;">
                @ViewBag.Detaylar
            </p>
        </div>
        
        <div class="col-md-5">
            <div class="card border-0 mb-4 shadow-sm" style="background-color: #f8f9fa; border-radius: 12px;">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-person-circle me-2"></i>@ViewBag.Kimden</h5>
                    
                    <button class="btn btn-outline-success w-100 mb-3 py-2 fw-bold">
                        <i class="bi bi-telephone-fill me-2"></i>İletişime Geç
                    </button>
                    
                    <form asp-controller="Sepet" asp-action="Ekle" method="post">
                        <input type="hidden" name="id" value="@ViewBag.Id" />
                        <input type="hidden" name="tip" value="@ViewBag.IlanTipi" />
                        <button type="submit" class="btn btn-warning w-100 fw-bold py-2 fs-5 shadow-sm">
                            <i class="bi bi-star-fill me-2"></i>Sepete Ekle
                        </button>
                    </form>

                    @* --- YALNIZCA ADMİN GÖREBİLİR --- *@
                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <div class="mt-3 border-top pt-3 text-center">
                            <small class="text-danger d-block mb-2 fw-bold">Yönetici Paneli</small>
                            <form asp-controller="Admin" asp-action="Sil" method="post" onsubmit="return confirm('DİKKAT: Bu ilanı ve tüm sepet referanslarını kalıcı olarak silmek istediğinize emin misiniz?');">
                                <input type="hidden" name="id" value="@ViewBag.Id" />
                                <input type="hidden" name="tip" value="@ViewBag.IlanTipi" />
                                <button type="submit" class="btn btn-danger w-100 fw-bold py-2">
                                    <i class="bi bi-trash-fill me-2"></i>İlanı Sistemden Kaldır
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>

            <!-- Teknik Özellikler Listesi -->
            <h5 class="fw-bold mb-3 px-1">Teknik Özellikler</h5>
            <ul class="list-group list-group-flush border rounded shadow-sm">
                <li class="list-group-item d-flex justify-content-between py-3">
                    <span class="text-secondary fw-semibold">İlan No</span>
                    <span class="fw-bold text-danger">@ViewBag.Id</span>
                </li>

                @if (ViewBag.IlanTipi == "Emlak")
                {
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-secondary fw-semibold">Oda Sayısı</span>
                        <span class="fw-bold text-dark">@ViewBag.OdaSayisi</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-secondary fw-semibold">Metrekare</span>
                        <span class="fw-bold text-dark">@ViewBag.Metrekare m²</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-secondary fw-semibold">Isıtma</span>
                        <span class="fw-bold text-dark">@ViewBag.Isitma</span>
                    </li>
                }
                else if (ViewBag.IlanTipi == "Vasita")
                {
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-secondary fw-semibold">Model Yılı</span>
                        <span class="fw-bold text-dark">@ViewBag.ModelYili</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-secondary fw-semibold">Kilometre</span>
                        <span class="fw-bold text-dark">@ViewBag.Kilometre km</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-secondary fw-semibold">Yakıt</span>
                        <span class="fw-bold text-dark">@ViewBag.Yakit</span>
                    </li>
                }
                else if (ViewBag.IlanTipi == "Esya")
                {
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-secondary fw-semibold">Kategori</span>
                        <span class="fw-bold text-dark">@ViewBag.Kategori</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between py-3">
                        <span class="text-secondary fw-semibold">Durum</span>
                        <span class="fw-bold text-dark">@ViewBag.Durum</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>