@model List<EgeHavaleProjeOdevi.Models.Esya>
@{
    ViewData["Title"] = "İkinci El ve Sıfır Alışveriş";
}
<div class="text-center mt-4 mb-5">
    <h2 class="display-6 fw-bold" style="color: #2c3e50;">@ViewBag.Message</h2>
</div>
<div class="row g-4">
    @foreach (var ilan in Model)
    {
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                <img src="@ilan.GorselUrl" class="card-img-top" alt="@ilan.Ad" style="height: 200px; object-fit: cover; border-bottom: 3px solid #17a2b8;" />
                <div class="card-body p-3">
                    <h5 class="card-title fw-bold text-dark text-truncate" title="@ilan.Ad">@ilan.Ad</h5>
                    <div class="d-flex justify-content-between mb-3 mt-2">
                        <span class="badge bg-info text-dark p-2">@ilan.Kategori</span>
                        <span class="badge bg-secondary p-2">@ilan.Durum</span>
                    </div>
                    <p class="card-text text-secondary mt-2" style="font-size: 0.9rem;">@ilan.Detaylar</p>
                </div>
                <div class="card-footer bg-white border-0 pb-3 pt-0 px-3">
                    <span class="fs-5 fw-bold text-success d-block mb-3">@ilan.Fiyat.ToString("C")</span>
                    <form asp-controller="Sepet" asp-action="Ekle" method="post" class="w-100">
                        <button type="submit" class="btn btn-outline-info w-100 fw-bold border-2 text-dark" style="border-radius: 6px;">
                            <i class="bi bi-star me-1"></i> Favorilere Ekle
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
