@{
    ViewData["Title"] = "Arama Sonuçları";
    var query = ViewBag.AramaKelimesi as string;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="container mt-4">
    <h2 class="mb-4">Arama Sonuçları</h2>

    @if (string.IsNullOrEmpty(query))
    {
        <div class="alert alert-info">Lütfen aramak istediğiniz kelimeyi girin.</div>
    }
    else
    {
        <p class="lead"><strong>"@query"</strong> için toplam @totalCount sonuç bulundu.</p>

        @if (totalCount == 0)
        {
            <div class="alert alert-warning">Aradığınız kriterlere uygun ilan bulunamadı.</div>
        }
        else
        {
            @if (ViewBag.Evler != null && ViewBag.Evler.Count > 0)
            {
                <h4 class="mt-4 border-bottom pb-2"><i class="bi bi-house-door"></i> Emlak İlanları (@ViewBag.Evler.Count)</h4>
                <div class="row g-4 mt-1">
                    @foreach (var item in ViewBag.Evler)
                    {
                        <div class="col-md-3">
                            <div class="card h-100 shadow-sm">
                                <img src="@item.GorselUrl" class="card-img-top" alt="@item.Ad" style="height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <h5 class="card-title text-truncate">@item.Ad</h5>
                                    <p class="card-text text-danger fw-bold fs-5">@item.Fiyat.ToString("C")</p>
                                    <p class="text-muted small mb-1"><i class="bi bi-geo-alt"></i> @item.Adres</p>
                                </div>
                                <div class="card-footer bg-white border-0">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary w-100">İlanı İncele</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (ViewBag.Vasitalar != null && ViewBag.Vasitalar.Count > 0)
            {
                <h4 class="mt-4 border-bottom pb-2"><i class="bi bi-car-front"></i> Vasıta İlanları (@ViewBag.Vasitalar.Count)</h4>
                <div class="row g-4 mt-1">
                    @foreach (var item in ViewBag.Vasitalar)
                    {
                        <div class="col-md-3">
                            <div class="card h-100 shadow-sm">
                                <img src="@item.GorselUrl" class="card-img-top" alt="@item.Ad" style="height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <h5 class="card-title text-truncate">@item.Ad</h5>
                                    <p class="card-text text-danger fw-bold fs-5">@item.Fiyat.ToString("C")</p>
                                    <p class="text-muted small mb-1"><i class="bi bi-car-front"></i> @item.ModelYili - @item.Kilometre km</p>
                                </div>
                                <div class="card-footer bg-white border-0">
                                    <a asp-action="VasitaDetails" asp-route-id="@item.Id" class="btn btn-outline-success w-100">İlanı İncele</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (ViewBag.Esyalar != null && ViewBag.Esyalar.Count > 0)
            {
                <h4 class="mt-4 border-bottom pb-2"><i class="bi bi-box-seam"></i> İkinci El İlanları (@ViewBag.Esyalar.Count)</h4>
                <div class="row g-4 mt-1">
                    @foreach (var item in ViewBag.Esyalar)
                    {
                        <div class="col-md-3">
                            <div class="card h-100 shadow-sm">
                                <img src="@item.GorselUrl" class="card-img-top" alt="@item.Ad" style="height: 200px; object-fit: cover;">
                                <div class="card-body">
                                    <h5 class="card-title text-truncate">@item.Ad</h5>
                                    <p class="card-text text-danger fw-bold fs-5">@item.Fiyat.ToString("C")</p>
                                    <p class="text-muted small mb-1">@item.Kategori - @item.Durum</p>
                                </div>
                                <div class="card-footer bg-white border-0">
                                    <button class="btn btn-outline-warning text-dark w-100">Detaylar (Yakında)</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (ViewBag.IsIlanlari != null && ViewBag.IsIlanlari.Count > 0)
            {
                <h4 class="mt-4 border-bottom pb-2"><i class="bi bi-briefcase"></i> İş İlanları (@ViewBag.IsIlanlari.Count)</h4>
                <div class="row g-4 mt-1">
                    @foreach (var item in ViewBag.IsIlanlari)
                    {
                        <div class="col-md-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body d-flex align-items-start">
                                    <img src="@item.GorselUrl" alt="Logo" class="rounded me-3" style="width: 60px; height: 60px; object-fit: cover;">
                                    <div>
                                        <h5 class="card-title mb-1">@item.Ad</h5>
                                        <h6 class="card-subtitle text-muted mb-2">@item.Sirket</h6>
                                        <span class="badge bg-danger">@item.CalismaTipi</span>
                                    </div>
                                </div>
                                <div class="card-footer bg-white border-0">
                                    <button class="btn btn-outline-danger w-100">Detaylar (Yakında)</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
</div>
