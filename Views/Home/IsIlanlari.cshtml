@model List<EgeHavaleProjeOdevi.Models.IsIlani>
@{
    ViewData["Title"] = "İş İlanları";
}
<div class="text-center mt-4 mb-5">
    <h2 class="display-6 fw-bold" style="color: #2c3e50;">@ViewBag.Message</h2>
</div>
<div class="row justify-content-center g-4">
    <div class="col-md-10">
        @foreach (var ilan in Model)
        {
            <div class="card mb-4 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                <div class="row g-0">
                    <div class="col-md-4">
                        <img src="@ilan.GorselUrl" class="img-fluid h-100 w-100" style="object-fit:cover; min-height: 200px;" alt="@ilan.Ad">
                    </div>
                    <div class="col-md-8">
                        <div class="card-body p-4 d-flex flex-column h-100 justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h4 class="card-title text-primary fw-bold mb-0">@ilan.Ad</h4>
                                    <span class="badge bg-success px-3 py-2 rounded-pill fs-6">@ilan.CalismaTipi</span>
                                </div>
                                <h6 class="text-secondary fw-semibold fs-5"><i class="bi bi-building text-dark me-2"></i>@ilan.Sirket</h6>
                                <h6 class="text-secondary fw-semibold mb-3"><i class="bi bi-geo-alt text-danger me-2"></i>@ilan.Adres</h6>
                                <p class="card-text text-muted" style="font-size: 1.05rem;">@ilan.Detaylar</p>
                            </div>
                            <div class="text-end mt-3">
                                <button class="btn btn-dark px-5 py-2 fw-bold rounded-pill shadow-sm">Hemen Başvur</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
