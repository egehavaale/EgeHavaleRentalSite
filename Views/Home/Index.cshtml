@model EgeHavaleProjeOdevi.Models.HomeViewModel

@{
    ViewData["Title"] = "Ana Sayfa";
}

<div class="container py-4">
    <div class="text-center mt-4 mb-5">
        <h2 class="display-6 fw-bold" style="color: #2c3e50;">Ege Havale İlan Platformu</h2>
        <p class="lead text-secondary">Aradığınız her şey burada!</p>
    </div>

    @if (Model.Evler.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold"><i class="bi bi-house-door me-2"></i>Öne Çıkan Evler</h3>
            <a href="@Url.Action("Evler", "Home")" class="text-decoration-none">Tümünü Gör</a>
        </div>
        <div class="row g-4 mb-5">
            @foreach (var ev in Model.Evler)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden; transition: transform 0.2s;">
                        <img src="@ev.GorselUrl" class="card-img-top" alt="@ev.Ad" style="height: 180px; object-fit: cover; border-bottom: 3px solid #ffcc00;" />
                        <div class="card-body p-3">
                            <h5 class="card-title text-primary fw-bold text-truncate" title="@ev.Ad">@ev.Ad</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-light text-dark border p-2"><i class="bi bi-house me-1"></i>@ev.OdaSayisi</span>
                                <span class="badge bg-light text-dark border p-2"><i class="bi bi-rulers me-1"></i>@ev.Metrekare m²</span>
                            </div>
                            <h6 class="card-subtitle mb-2 text-muted fw-semibold" style="font-size: 0.85rem;">@ev.Adres</h6>
                            <span class="fs-5 fw-bold text-success">@ev.Fiyat.ToString("C")</span>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3 pt-0 px-3">
                            <a href="@Url.Action("Details", "Home", new { id = ev.Id })" class="btn btn-warning fw-bold text-dark w-100 shadow-sm" style="background-color: #ffcc00; border: none;">İlan Detayı</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.Vasitalar.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold"><i class="bi bi-car-front me-2"></i>Öne Çıkan Araçlar</h3>
            <a href="@Url.Action("Vasita", "Home")" class="text-decoration-none">Tümünü Gör</a>
        </div>
        <div class="row g-4 mb-5">
            @foreach (var v in Model.Vasitalar)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                        <img src="@v.GorselUrl" class="card-img-top" alt="@v.Ad" style="height: 180px; object-fit: cover; border-bottom: 3px solid #0dcaf0;" />
                        <div class="card-body p-3">
                            <h5 class="card-title text-info fw-bold text-truncate">@v.Ad</h5>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="badge bg-light text-dark border p-2">@v.ModelYili</span>
                                <span class="badge bg-light text-dark border p-2">@v.Kilometre km</span>
                            </div>
                            <h6 class="card-subtitle mb-2 text-muted" style="font-size: 0.85rem;">@v.Vites | @v.Yakit</h6>
                            <span class="fs-5 fw-bold text-success">@v.Fiyat.ToString("C")</span>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3 pt-0 px-3">
                            <a href="@Url.Action("VasitaDetails", "Home", new { id = v.Id })" class="btn btn-info fw-bold text-white w-100 shadow-sm" style="border: none;">İlan Detayı</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.Esyalar.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold"><i class="bi bi-box-seam me-2"></i>İkinci El & Sıfır</h3>
            <a href="@Url.Action("IkinciEl", "Home")" class="text-decoration-none">Tümünü Gör</a>
        </div>
        <div class="row g-4 mb-5">
            @foreach (var e in Model.Esyalar)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="card h-100 shadow-sm border-0" style="border-radius: 12px; overflow: hidden;">
                        <img src="@e.GorselUrl" class="card-img-top" alt="@e.Ad" style="height: 180px; object-fit: cover; border-bottom: 3px solid #6f42c1;" />
                        <div class="card-body p-3">
                            <h5 class="card-title text-primary fw-bold text-truncate">@e.Ad</h5>
                            <span class="badge bg-purple text-white mb-2" style="background-color: #6f42c1;">@e.Kategori</span>
                            <p class="text-muted small">Durum: @e.Durum</p>
                            <span class="fs-5 fw-bold text-success">@e.Fiyat.ToString("C")</span>
                        </div>
                        <div class="card-footer bg-white border-0 pb-3 pt-0 px-3">
                            <a href="#" class="btn btn-outline-primary w-100 fw-bold">Detay</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

        @if (Model.IsIlanlari.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold"><i class="bi bi-briefcase me-2"></i>Kariyer Fırsatları</h3>
            <a href="@Url.Action("IsIlanlari", "Home")" class="text-decoration-none">Tümünü Gör</a>
        </div>
        <div class="row g-4 mb-5">
            @foreach (var isI in Model.IsIlanlari)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-start border-primary border-4" style="border-radius: 8px;">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <img src="@isI.GorselUrl" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                                <div>
                                    <h5 class="card-title mb-0 fw-bold">@isI.Pozisyon</h5>
                                    <small class="text-muted">@isI.Sirket</small>
                                </div>
                            </div>
                            <p class="card-text small text-secondary">@isI.Adres</p>
                            <span class="badge bg-light text-primary border">@isI.CalismaTipi</span>
                        </div>
                        <div class="card-footer bg-transparent border-0">
                            <a href="#" class="btn btn-link p-0 fw-bold text-decoration-none">İncele <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <style>
        .card:hover {
            transform: translateY(-5px);
            transition: all 0.3s ease;
        }
    </style>
}